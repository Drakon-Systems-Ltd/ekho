# systemd user unit for the Ekho MCP connector.
#
# Install:   mkdir -p ~/.config/systemd/user && cp ekho-mcp.service ~/.config/systemd/user/
#            mkdir -p ~/.config/ekho-mcp && $EDITOR ~/.config/ekho-mcp/env && chmod 600 ~/.config/ekho-mcp/env
#            systemctl --user daemon-reload && systemctl --user enable --now ekho-mcp
#            loginctl enable-linger "$USER"      # keep it running when you log out
# Logs:      journalctl --user -u ekho-mcp -f
#
# The environment file is the whole configuration (see README → Configuration).
# ExecStart assumes `npm install -g @drakon-systems/ekho-mcp` put `ekho-mcp` on
# /usr/local/bin; for a checkout use `node /path/to/ekho/packages/mcp-connector/dist/cli.js`.

[Unit]
Description=Ekho MCP connector (Grok and other MCP clients)
Documentation=https://github.com/Drakon-Systems-Ltd/ekho/tree/main/packages/mcp-connector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/ekho-mcp/env
ExecStart=/usr/local/bin/ekho-mcp
Restart=on-failure
RestartSec=5s
# Refuses to start (exit 1, no restart loop) on a config error or an unreadable
# identity/credentials file: those need a human, not a retry.
RestartPreventExitStatus=1
NoNewPrivileges=true
UMask=0077
KillSignal=SIGTERM
TimeoutStopSec=20s

[Install]
WantedBy=default.target
