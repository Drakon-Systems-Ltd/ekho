EKHO_HOST=127.0.0.1
EKHO_PORT=4000
EKHO_BASE_URL=http://127.0.0.1:4000
EKHO_DB_PATH=./data/ekho.sqlite
# Required. `npm run setup` generates one automatically; otherwise set your own:
#   openssl rand -hex 32
EKHO_OPERATOR_SESSION_SECRET=
EKHO_TIMESTAMP_SKEW_SECONDS=300
EKHO_POLL_INTERVAL_SECONDS=5
EKHO_HEARTBEAT_INTERVAL_SECONDS=30

# TLS (optional — set BOTH to serve HTTPS directly; omit to run behind a
# TLS-terminating proxy such as Caddy, nginx, or a Kubernetes ingress)
# EKHO_TLS_CERT_PATH=./certs/cert.pem
# EKHO_TLS_KEY_PATH=./certs/key.pem

# License (optional — omit for OSS mode)
# EKHO_LICENSE_KEY=
# EKHO_LICENSE_PATH=
