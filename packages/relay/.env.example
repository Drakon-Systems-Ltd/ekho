EKHO_HOST=127.0.0.1
EKHO_PORT=4000
EKHO_BASE_URL=http://127.0.0.1:4000
EKHO_DB_PATH=./data/ekho.sqlite
# Required. `npm run setup` generates one automatically; otherwise set your own:
#   openssl rand -hex 32
EKHO_OPERATOR_SESSION_SECRET=
EKHO_TIMESTAMP_SKEW_SECONDS=300
EKHO_POLL_INTERVAL_SECONDS=5
EKHO_HEARTBEAT_INTERVAL_SECONDS=30

# TLS (optional — set BOTH to serve HTTPS directly; omit to run behind a
# TLS-terminating proxy such as Caddy, nginx, or a Kubernetes ingress)
# EKHO_TLS_CERT_PATH=./certs/cert.pem
# EKHO_TLS_KEY_PATH=./certs/key.pem

# License (optional — omit for OSS mode)
# EKHO_LICENSE_KEY=
# EKHO_LICENSE_PATH=

# File attachments (optional — sensible defaults derive from EKHO_DB_PATH)
# EKHO_ATTACHMENTS_DIR=./data/attachments
# EKHO_ATTACHMENT_MAX_BYTES=26214400        # 25 MiB hard cap (declared + decoded)
# EKHO_ATTACHMENT_MAX_PER_MESSAGE=10

# History retention (optional — the sweep prunes both automatically)
# Heartbeats are liveness, not history; each agent's newest row is always kept.
# EKHO_HEARTBEAT_RETENTION_SECONDS=172800   # 48h
# Only high-volume operational event types are pruned. The audit trail
# (operator keys, policy, approvals, trust/quarantine, room + feed lifecycle) is
# kept regardless of this setting.
# EKHO_EVENT_RETENTION_SECONDS=2592000      # 30 days
