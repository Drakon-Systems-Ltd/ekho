{
  "name": "@ekho/relay",
  "version": "0.2.1",
  "description": "Ekho relay server — private communication and control layer for distributed AI agents.",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "setup": "tsx src/setup.ts",
    "doctor": "tsx src/setup.ts --doctor",
    "typecheck": "tsc --noEmit",
    "agent:demo": "tsx src/demo-agent.ts",
    "ui:dev": "vite",
    "ui:build": "vite build --config vite.config.mjs",
    "build": "npm run ui:build && npm run typecheck",
    "test": "vitest run"
  },
  "optionalDependencies": {
    "@ekho/shieldcortex-bridge": "*"
  },
  "dependencies": {
    "@drakon-systems/ekho-sdk": "*",
    "@fastify/static": "^10.1.2",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "better-sqlite3": "^12.8.0",
    "dotenv": "^17.4.0",
    "fastify": "^5.8.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "vite": "^8.0.3"
  }
}
